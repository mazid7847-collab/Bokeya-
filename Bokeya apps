<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ধারের হিসাব ও দৈনন্দিন ডায়েরি</title>
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Font Awesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <style>
    /* Prevent zooming on mobile devices */
    html, body {
      touch-action: manipulation;
      -webkit-text-size-adjust: 100%;
    }
    input, textarea, button, select {
      font-size: 16px !important;
    }
  </style>
</head>
<body class="bg-slate-100 font-sans min-h-screen pb-12 select-none">

  <!-- ==================== PHONE AUTH SECTION (LOGIN SCREEN) ==================== -->
  <section id="auth-section" class="max-w-md mx-auto p-4 min-h-screen flex flex-col justify-center items-center">
    <div class="w-full bg-white rounded-2xl shadow-xl p-6 border border-slate-200 text-center">
      <div class="w-16 h-16 bg-indigo-100 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
        <i class="fa-solid fa-mobile-screen-button"></i>
      </div>
      <h2 class="text-xl font-bold text-slate-800 mb-1">স্বাগতম!</h2>
      <p class="text-xs text-slate-500 mb-6">আপনার মোবাইল নম্বর দিয়ে OTP কোড পেয়ে লগইন করুন</p>

      <!-- Step 1: Phone Input Form -->
      <div id="phone-step" class="space-y-4">
        <div>
          <label class="block text-left text-xs font-semibold text-slate-600 mb-1">মোবাইল নম্বর</label>
          <div class="flex items-center border border-slate-300 rounded-lg overflow-hidden focus-within:ring-2 focus-within:ring-indigo-500">
            <span class="bg-slate-100 px-3 py-2 text-slate-600 text-sm font-semibold border-r border-slate-300">+880</span>
            <input type="tel" id="user-phone" placeholder="17XXXXXXXX" class="w-full px-3 py-2 focus:outline-none text-sm">
          </div>
        </div>

        <!-- Recaptcha Container -->
        <div id="recaptcha-container" class="flex justify-center my-2"></div>

        <button onclick="sendOTP()" id="send-otp-btn" class="w-full bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg shadow-sm transition active:scale-95 flex justify-center items-center gap-2">
          <i class="fa-solid fa-paper-plane"></i> OTP পাঠান
        </button>
      </div>

      <!-- Step 2: OTP Verification Form -->
      <div id="otp-step" class="space-y-4 hidden">
        <div>
          <label class="block text-left text-xs font-semibold text-slate-600 mb-1">৬ ডিজিটের OTP কোড</label>
          <input type="number" id="otp-code" placeholder="123456" class="w-full px-3 py-2 text-center text-lg tracking-widest border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
        </div>

        <button onclick="verifyOTP()" id="verify-otp-btn" class="w-full bg-green-600 hover:bg-green-700 text-white font-semibold py-2.5 rounded-lg shadow-sm transition active:scale-95 flex justify-center items-center gap-2">
          <i class="fa-solid fa-shield-check"></i> নিশ্চিত করুন ও প্রবেশ করুন
        </button>

        <button onclick="resetAuth()" class="text-xs text-slate-500 underline hover:text-indigo-600">
          ভুল নম্বর? আবার চেষ্টা করুন
        </button>
      </div>
    </div>
  </section>

  <!-- ==================== MAIN APP SECTION (AFTER LOGIN) ==================== -->
  <div id="app-section" class="hidden">
    <!-- Header -->
    <header class="bg-indigo-700 text-white shadow-md sticky top-0 z-50">
      <div class="max-w-md mx-auto px-4 py-3 flex justify-between items-center">
        <h1 class="text-lg font-bold flex items-center gap-2">
          <i class="fa-solid fa-book-bookmark"></i> হিসাব ও ডায়েরি
        </h1>
        <div class="flex items-center gap-2">
          <span id="user-display-phone" class="text-xs bg-indigo-800 text-indigo-100 px-2 py-1 rounded-md font-mono"></span>
          <button onclick="logoutUser()" title="লগআউট" class="text-xs bg-red-500 hover:bg-red-600 px-2.5 py-1 rounded-md transition font-semibold flex items-center gap-1">
            <i class="fa-solid fa-right-from-bracket"></i>
          </button>
        </div>
      </div>

      <!-- Navigation Tabs -->
      <nav class="flex border-t border-indigo-600 bg-indigo-800 text-indigo-100 text-sm font-medium">
        <button id="tab-debt-btn" onclick="switchTab('debt')" class="flex-1 py-2.5 text-center border-b-2 border-white font-bold text-white transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-hand-holding-dollar"></i> ধারের হিসাব
        </button>
        <button id="tab-diary-btn" onclick="switchTab('diary')" class="flex-1 py-2.5 text-center border-b-2 border-transparent hover:text-white transition-all flex items-center justify-center gap-2">
          <i class="fa-solid fa-journal-whills"></i> দৈনন্দিন ডায়েরি
        </button>
      </nav>
    </header>

    <!-- Main Container -->
    <main class="max-w-md mx-auto p-4">

      <!-- Toast Notification -->
      <div id="toast" class="hidden fixed bottom-5 left-1/2 -translate-x-1/2 bg-slate-800 text-white text-sm px-4 py-2.5 rounded-lg shadow-lg z-50 transition-opacity duration-300 flex items-center gap-2">
        <i class="fa-solid fa-circle-check text-green-400" id="toast-icon"></i>
        <span id="toast-msg">সফলভাবে সংরক্ষিত হয়েছে!</span>
      </div>

      <!-- ==================== SECTION 1: DHAR / DEBT TRACKER ==================== -->
      <section id="section-debt" class="space-y-4">
        
        <!-- Card: Add/Edit Debt -->
        <div class="bg-white rounded-xl shadow-sm p-4 border border-slate-200">
          <h2 id="debt-form-title" class="text-lg font-bold text-slate-800 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-plus-circle text-indigo-600"></i> নতুন ধারের তথ্য যোগ করুন
          </h2>
          
          <form id="debt-form" onsubmit="handleDebtSubmit(event)" class="space-y-3">
            <input type="hidden" id="debt-id" value="">
            
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">গ্রহীতা / দাতার নাম *</label>
              <input type="text" id="debt-name" required placeholder="নাম লিখুন" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div class="grid grid-cols-2 gap-2">
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">টাকার পরিমাণ (৳) *</label>
                <input type="number" id="debt-amount" required placeholder="0.00" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">তারিখ *</label>
                <input type="date" id="debt-date" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">মোবাইল নম্বর (ঐচ্ছিক)</label>
              <input type="tel" id="debt-phone" placeholder="017XXXXXXXX" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div class="flex gap-2 pt-1">
              <button type="submit" id="debt-submit-btn" class="flex-1 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 rounded-lg shadow-sm transition active:scale-95 flex justify-center items-center gap-2">
                <i class="fa-solid fa-floppy-disk"></i> <span id="debt-btn-text">সংরক্ষণ করুন</span>
              </button>
              <button type="button" id="debt-cancel-btn" onclick="resetDebtForm()" class="hidden bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-4 py-2.5 rounded-lg transition">
                বাতিল
              </button>
            </div>
          </form>
        </div>

        <!-- Total Summary -->
        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 flex justify-between items-center">
          <div>
            <span class="text-xs text-indigo-600 font-semibold uppercase tracking-wider block">মোট বকেয়া পরিমাণ</span>
            <span id="total-pending-amount" class="text-xl font-black text-indigo-900">৳ 0.00</span>
          </div>
          <div class="text-right">
            <span id="total-count" class="text-xs font-medium bg-indigo-200 text-indigo-800 px-2 py-1 rounded-full">0 টি এন্ট্রি</span>
          </div>
        </div>

        <!-- Debt List Filter & Items -->
        <div>
          <div class="flex justify-between items-center mb-2 px-1">
            <h3 class="text-sm font-bold text-slate-700">সংরক্ষিত হিসাবসমূহ</h3>
            <input type="text" id="debt-search" oninput="renderDebts()" placeholder="নাম দিয়ে খুঁজুন..." class="text-xs px-2.5 py-1 border border-slate-300 rounded-md focus:outline-none">
          </div>

          <div id="debt-list" class="space-y-2">
            <div class="text-center py-8 text-slate-400 text-sm">তথ্য লোড হচ্ছে...</div>
          </div>
        </div>

      </section>

      <!-- ==================== SECTION 2: DAILY DIARY ==================== -->
      <section id="section-diary" class="space-y-4 hidden">
        
        <!-- Card: Add/Edit Diary Note -->
        <div class="bg-white rounded-xl shadow-sm p-4 border border-slate-200">
          <h2 id="diary-form-title" class="text-lg font-bold text-slate-800 mb-3 flex items-center gap-2">
            <i class="fa-solid fa-pen-to-square text-emerald-600"></i> ডায়েরিতে নতুন তথ্য লিখুন
          </h2>
          
          <form id="diary-form" onsubmit="handleDiarySubmit(event)" class="space-y-3">
            <input type="hidden" id="diary-id" value="">

            <div class="grid grid-cols-3 gap-2">
              <div class="col-span-2">
                <label class="block text-xs font-semibold text-slate-600 mb-1">শিরোনাম / বিষয় *</label>
                <input type="text" id="diary-title" required placeholder="আজকের সংক্ষিপ্ত শিরোনাম" class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-600 mb-1">তারিখ *</label>
                <input type="date" id="diary-date" required class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">বিস্তারিত বিবরণ *</label>
              <textarea id="diary-content" required rows="4" placeholder="আজকের সারাদিনের হিসাব বা নোট এখানে লিখুন..." class="w-full px-3 py-2 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-emerald-500"></textarea>
            </div>

            <div class="flex gap-2 pt-1">
              <button type="submit" id="diary-submit-btn" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2.5 rounded-lg shadow-sm transition active:scale-95 flex justify-center items-center gap-2">
                <i class="fa-solid fa-floppy-disk"></i> <span id="diary-btn-text">ডায়েরিতে সেভ করুন</span>
              </button>
              <button type="button" id="diary-cancel-btn" onclick="resetDiaryForm()" class="hidden bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold px-4 py-2.5 rounded-lg transition">
                বাতিল
              </button>
            </div>
          </form>
        </div>

        <!-- Diary Entries List -->
        <div>
          <h3 class="text-sm font-bold text-slate-700 mb-2 px-1">সংরক্ষিত নোটসমূহ</h3>
          <div id="diary-list" class="space-y-3">
            <div class="text-center py-8 text-slate-400 text-sm">তথ্য লোড হচ্ছে...</div>
          </div>
        </div>

      </section>

    </main>
  </div>

  <!-- Firebase JavaScript SDK (v10 Modular) -->
  <script type="module">
    import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
    import { getAuth, RecaptchaVerifier, signInWithPhoneNumber, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js";
    import { getDatabase, ref, push, set, onValue, remove } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    // Firebase Configuration
    const firebaseConfig = {
      apiKey: "AIzaSyDjGCXiv5AspLufj5pqTayd93F5HQtwhKc",
      authDomain: "dhar-taka.firebaseapp.com",
      databaseURL: "https://dhar-taka-default-rtdb.firebaseio.com",
      projectId: "dhar-taka",
      storageBucket: "dhar-taka.firebasestorage.app",
      messagingSenderId: "831524140918",
      appId: "1:831524140918:web:be0dc2eac0aa137866ec57",
      measurementId: "G-BM97V2PFB6"
    };

    // Initialize Firebase
    const app = initializeApp(firebaseConfig);
    const auth = getAuth(app);
    const db = getDatabase(app);

    let confirmationResult = null;
    let currentUser = null;

    window.debtsData = {};
    window.diaryData = {};

    // DOM Loaded Setup
    document.addEventListener("DOMContentLoaded", () => {
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('debt-date').value = today;
      document.getElementById('diary-date').value = today;

      // Recaptcha Verifier Initialization
      window.recaptchaVerifier = new RecaptchaVerifier(auth, 'recaptcha-container', {
        'size': 'invisible'
      });
    });

    // Auth State Observer
    onAuthStateChanged(auth, (user) => {
      if (user) {
        currentUser = user;
        document.getElementById('auth-section').classList.add('hidden');
        document.getElementById('app-section').classList.remove('hidden');
        document.getElementById('user-display-phone').innerText = user.phoneNumber || "ইউজার";
        attachRealtimeListeners(user.uid);
      } else {
        currentUser = null;
        document.getElementById('auth-section').classList.remove('hidden');
        document.getElementById('app-section').classList.add('hidden');
      }
    });

    // Send OTP Function
    window.sendOTP = async function() {
      const phoneInput = document.getElementById('user-phone').value.trim();
      if (!phoneInput || phoneInput.length < 10) {
        alert("দয়া করে একটি সঠিক ১০ ডিজিটের মোবাইল নম্বর লিখুন।");
        return;
      }

      const fullPhoneNumber = "+880" + phoneInput;
      const sendBtn = document.getElementById('send-otp-btn');
      sendBtn.innerText = "পাঠানো হচ্ছে...";

      try {
        confirmationResult = await signInWithPhoneNumber(auth, fullPhoneNumber, window.recaptchaVerifier);
        document.getElementById('phone-step').classList.add('hidden');
        document.getElementById('otp-step').classList.remove('hidden');
        showToast("OTP কোড পাঠানো হয়েছে!");
      } catch (error) {
        alert("OTP পাঠাতে সমস্যা হয়েছে: " + error.message);
        if (window.recaptchaVerifier) {
          window.recaptchaVerifier.render().then(widgetId => grecaptcha.reset(widgetId));
        }
      } finally {
        sendBtn.innerText = "OTP পাঠান";
      }
    };

    // Verify OTP Function
    window.verifyOTP = async function() {
      const otpCode = document.getElementById('otp-code').value.trim();
      if (!otpCode || otpCode.length !== 6) {
        alert("দয়া করে ৬ ডিজিটের OTP কোড লিখুন।");
        return;
      }

      const verifyBtn = document.getElementById('verify-otp-btn');
      verifyBtn.innerText = "যাচাই করা হচ্ছে...";

      try {
        await confirmationResult.confirm(otpCode);
        showToast("সফলভাবে প্রবেশ করেছেন!");
      } catch (error) {
        alert("ভুল OTP কোড! আবার চেষ্টা করুন।");
      } finally {
        verifyBtn.innerText = "নিশ্চিত করুন ও প্রবেশ করুন";
      }
    };

    // Reset Auth View
    window.resetAuth = function() {
      document.getElementById('phone-step').classList.remove('hidden');
      document.getElementById('otp-step').classList.add('hidden');
    };

    // Logout User
    window.logoutUser = function() {
      if (confirm("আপনি কি নিশ্চিতভাবে লগআউট করতে চান?")) {
        signOut(auth);
      }
    };

    // Attach Database Listeners
    function attachRealtimeListeners(uid) {
      const debtsRef = ref(db, `users/${uid}/debts`);
      onValue(debtsRef, (snapshot) => {
        window.debtsData = snapshot.val() || {};
        window.renderDebts();
      });

      const diaryRef = ref(db, `users/${uid}/diary`);
      onValue(diaryRef, (snapshot) => {
        window.diaryData = snapshot.val() || {};
        window.renderDiary();
      });
    }

    // Submit Debt Item
    window.handleDebtSubmit = async function(event) {
      event.preventDefault();
      if (!currentUser) return;

      const id = document.getElementById('debt-id').value;
      const name = document.getElementById('debt-name').value.trim();
      const amount = parseFloat(document.getElementById('debt-amount').value);
      const date = document.getElementById('debt-date').value;
      const phone = document.getElementById('debt-phone').value.trim();

      const btnText = document.getElementById('debt-btn-text');
      btnText.innerText = "সংরক্ষণ হচ্ছে...";

      try {
        if (id) {
          const isPaid = window.debtsData[id] ? window.debtsData[id].isPaid : false;
          await set(ref(db, `users/${currentUser.uid}/debts/${id}`), { name, amount, date, phone, isPaid, updatedAt: Date.now() });
          showToast("হিসাব আপডেট করা হয়েছে!");
        } else {
          const newRef = push(ref(db, `users/${currentUser.uid}/debts`));
          await set(newRef, { name, amount, date, phone, isPaid: false, createdAt: Date.now() });
          showToast("নতুন ধারের হিসাব সেভ করা হয়েছে!");
        }
        resetDebtForm();
      } catch (err) {
        alert("সংরক্ষণ করতে সমস্যা হয়েছে: " + err.message);
      } finally {
        btnText.innerText = "সংরক্ষণ করুন";
      }
    };

    // Submit Diary Item
    window.handleDiarySubmit = async function(event) {
      event.preventDefault();
      if (!currentUser) return;

      const id = document.getElementById('diary-id').value;
      const title = document.getElementById('diary-title').value.trim();
      const date = document.getElementById('diary-date').value;
      const content = document.getElementById('diary-content').value.trim();

      const btnText = document.getElementById('diary-btn-text');
      btnText.innerText = "সংরক্ষণ হচ্ছে...";

      try {
        if (id) {
          await set(ref(db, `users/${currentUser.uid}/diary/${id}`), { title, date, content, updatedAt: Date.now() });
          showToast("ডায়েরি নোট আপডেট করা হয়েছে!");
        } else {
          const newRef = push(ref(db, `users/${currentUser.uid}/diary`));
          await set(newRef, { title, date, content, createdAt: Date.now() });
          showToast("ডায়েরিতে নতুন তথ্য সেভ করা হয়েছে!");
        }
        resetDiaryForm();
      } catch (err) {
        alert("ডায়েরি সেভ করতে সমস্যা হয়েছে: " + err.message);
      } finally {
        btnText.innerText = "ডায়েরিতে সেভ করুন";
      }
    };

    // Toggle Paid Status
    window.togglePaidStatus = async function(id) {
      if (!currentUser || !window.debtsData[id]) return;
      const current = window.debtsData[id].isPaid;
      await set(ref(db, `users/${currentUser.uid}/debts/${id}/isPaid`), !current);
      showToast(!current ? "পরিশোধিত হিসেবে চিহ্নিত করা হয়েছে" : "অপরিশোধিত হিসেবে চিহ্নিত করা হয়েছে");
    };

    // Delete Debt Item
    window.deleteDebt = async function(id) {
      if (!currentUser) return;
      if (confirm("আপনি কি নিশ্চিতভাবে এই হিসাবটি মুছে ফেলতে চান?")) {
        await remove(ref(db, `users/${currentUser.uid}/debts/${id}`));
        showToast("হিসাব মুছে ফেলা হয়েছে");
      }
    };

    // Delete Diary Item
    window.deleteDiary = async function(id) {
      if (!currentUser) return;
      if (confirm("আপনি কি নিশ্চিতভাবে এই ডায়েরি নোটটি মুছে ফেলতে চান?")) {
        await remove(ref(db, `users/${currentUser.uid}/diary/${id}`));
        showToast("ডায়েরি নোট মুছে ফেলা হয়েছে");
      }
    };

  </script>

  <!-- UI Render & Helper Functions -->
  <script>
    function switchTab(tab) {
      const debtSec = document.getElementById('section-debt');
      const diarySec = document.getElementById('section-diary');
      const debtBtn = document.getElementById('tab-debt-btn');
      const diaryBtn = document.getElementById('tab-diary-btn');

      if (tab === 'debt') {
        debtSec.classList.remove('hidden');
        diarySec.classList.add('hidden');
        debtBtn.className = "flex-1 py-2.5 text-center border-b-2 border-white font-bold text-white transition-all flex items-center justify-center gap-2";
        diaryBtn.className = "flex-1 py-2.5 text-center border-b-2 border-transparent text-indigo-200 hover:text-white transition-all flex items-center justify-center gap-2";
      } else {
        debtSec.classList.add('hidden');
        diarySec.classList.remove('hidden');
        diaryBtn.className = "flex-1 py-2.5 text-center border-b-2 border-white font-bold text-white transition-all flex items-center justify-center gap-2";
        debtBtn.className = "flex-1 py-2.5 text-center border-b-2 border-transparent text-indigo-200 hover:text-white transition-all flex items-center justify-center gap-2";
      }
    }

    function renderDebts() {
      const listContainer = document.getElementById('debt-list');
      const searchVal = document.getElementById('debt-search').value.toLowerCase();
      const debts = window.debtsData || {};

      const keys = Object.keys(debts);
      if (keys.length === 0) {
        listContainer.innerHTML = `<div class="bg-white p-6 rounded-xl text-center text-slate-400 text-sm">কোনো হিসাব সংরক্ষিত নেই।</div>`;
        document.getElementById('total-pending-amount').innerText = `৳ 0.00`;
        document.getElementById('total-count').innerText = `0 টি এন্ট্রি`;
        return;
      }

      let html = '';
      let totalPending = 0;
      let matchCount = 0;

      keys.sort((a,b) => (debts[b].createdAt || 0) - (debts[a].createdAt || 0));

      keys.forEach(id => {
        const item = debts[id];
        if (searchVal && !item.name.toLowerCase().includes(searchVal)) return;

        matchCount++;
        if (!item.isPaid) totalPending += Number(item.amount || 0);

        html += `
          <div class="bg-white p-3.5 rounded-xl border ${item.isPaid ? 'border-green-200 bg-green-50/30' : 'border-slate-200'} shadow-sm flex flex-col gap-2">
            <div class="flex justify-between items-start">
              <div>
                <div class="flex items-center gap-2">
                  <h4 class="font-bold text-slate-800 text-base">${escapeHtml(item.name)}</h4>
                  ${item.isPaid ? 
                    `<span class="text-[10px] bg-green-100 text-green-700 font-bold px-2 py-0.5 rounded-full">পরিশোধিত</span>` : 
                    `<span class="text-[10px] bg-red-100 text-red-700 font-bold px-2 py-0.5 rounded-full">বকেয়া</span>`}
                </div>
                <p class="text-xs text-slate-500 mt-0.5"><i class="fa-regular fa-calendar-check me-1"></i> ${item.date}</p>
              </div>
              <div class="text-right">
                <span class="text-lg font-black ${item.isPaid ? 'text-green-600 line-through' : 'text-indigo-700'}">৳ ${Number(item.amount).toLocaleString('bn-BD')}</span>
              </div>
            </div>

            ${item.phone ? `
              <div class="text-xs text-slate-600 flex items-center gap-1">
                <i class="fa-solid fa-phone text-slate-400"></i> 
                <a href="tel:${item.phone}" class="text-indigo-600 underline font-medium">${item.phone}</a>
              </div>
            ` : ''}

            <div class="flex justify-between items-center pt-2 border-t border-slate-100 text-xs">
              <button onclick="togglePaidStatus('${id}')" class="font-semibold ${item.isPaid ? 'text-slate-600 hover:text-slate-800' : 'text-green-600 hover:text-green-800'} flex items-center gap-1">
                <i class="fa-solid ${item.isPaid ? 'fa-rotate-left' : 'fa-circle-check'}"></i> 
                ${item.isPaid ? 'বকেয়া চিহ্নিত করুন' : 'পরিশোধ হয়েছে'}
              </button>

              <div class="flex items-center gap-3">
                <button onclick="editDebt('${id}')" class="text-indigo-600 hover:text-indigo-800 font-semibold flex items-center gap-1">
                  <i class="fa-solid fa-pen"></i> এডিট
                </button>
                <button onclick="deleteDebt('${id}')" class="text-red-500 hover:text-red-700 font-semibold flex items-center gap-1">
                  <i class="fa-solid fa-trash"></i> ডিলিট
                </button>
              </div>
            </div>
          </div>
        `;
      });

      listContainer.innerHTML = html || `<div class="bg-white p-4 rounded-xl text-center text-slate-400 text-sm">কোনো ফলাফল পাওয়া যায়নি।</div>`;
      document.getElementById('total-pending-amount').innerText = `৳ ${totalPending.toLocaleString('bn-BD')}`;
      document.getElementById('total-count').innerText = `${matchCount} টি এন্ট্রি`;
    }

    function renderDiary() {
      const listContainer = document.getElementById('diary-list');
      const diary = window.diaryData || {};

      const keys = Object.keys(diary);
      if (keys.length === 0) {
        listContainer.innerHTML = `<div class="bg-white p-6 rounded-xl text-center text-slate-400 text-sm">ডায়েরিতে এখনো কোনো তথ্য লেখা হয়নি।</div>`;
        return;
      }

      let html = '';
      keys.sort((a,b) => (diary[b].createdAt || 0) - (diary[a].createdAt || 0));

      keys.forEach(id => {
        const note = diary[id];
        html += `
          <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-2">
            <div class="flex justify-between items-start border-b border-slate-100 pb-2">
              <h4 class="font-bold text-slate-800 text-base">${escapeHtml(note.title)}</h4>
              <span class="text-xs font-semibold bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md flex items-center gap-1">
                <i class="fa-regular fa-calendar-days"></i> ${note.date}
              </span>
            </div>
            
            <p class="text-sm text-slate-700 whitespace-pre-line leading-relaxed">${escapeHtml(note.content)}</p>

            <div class="flex justify-end items-center gap-3 pt-2 text-xs border-t border-slate-100">
              <button onclick="editDiary('${id}')" class="text-emerald-600 hover:text-emerald-800 font-semibold flex items-center gap-1">
                <i class="fa-solid fa-pen-to-square"></i> এডিট
              </button>
              <button onclick="deleteDiary('${id}')" class="text-red-500 hover:text-red-700 font-semibold flex items-center gap-1">
                <i class="fa-solid fa-trash"></i> ডিলিট
              </button>
            </div>
          </div>
        `;
      });

      listContainer.innerHTML = html;
    }

    function editDebt(id) {
      const item = window.debtsData[id];
      if (!item) return;

      document.getElementById('debt-id').value = id;
      document.getElementById('debt-name').value = item.name;
      document.getElementById('debt-amount').value = item.amount;
      document.getElementById('debt-date').value = item.date;
      document.getElementById('debt-phone').value = item.phone || '';

      document.getElementById('debt-form-title').innerHTML = `<i class="fa-solid fa-pen text-indigo-600"></i> তথ্য এডিট করুন`;
      document.getElementById('debt-btn-text').innerText = 'আপডেট করুন';
      document.getElementById('debt-cancel-btn').classList.remove('hidden');

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetDebtForm() {
      document.getElementById('debt-form').reset();
      document.getElementById('debt-id').value = '';
      document.getElementById('debt-date').value = new Date().toISOString().split('T')[0];

      document.getElementById('debt-form-title').innerHTML = `<i class="fa-solid fa-plus-circle text-indigo-600"></i> নতুন ধারের তথ্য যোগ করুন`;
      document.getElementById('debt-btn-text').innerText = 'সংরক্ষণ করুন';
      document.getElementById('debt-cancel-btn').classList.add('hidden');
    }

    function editDiary(id) {
      const note = window.diaryData[id];
      if (!note) return;

      document.getElementById('diary-id').value = id;
      document.getElementById('diary-title').value = note.title;
      document.getElementById('diary-date').value = note.date;
      document.getElementById('diary-content').value = note.content;

      document.getElementById('diary-form-title').innerHTML = `<i class="fa-solid fa-pen text-emerald-600"></i> ডায়েরি সম্পাদনা করুন`;
      document.getElementById('diary-btn-text').innerText = 'আপডেট করুন';
      document.getElementById('diary-cancel-btn').classList.add('hidden');

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function resetDiaryForm() {
      document.getElementById('diary-form').reset();
      document.getElementById('diary-id').value = '';
      document.getElementById('diary-date').value = new Date().toISOString().split('T')[0];

      document.getElementById('diary-form-title').innerHTML = `<i class="fa-solid fa-pen-to-square text-emerald-600"></i> ডায়েরিতে নতুন তথ্য লিখুন`;
      document.getElementById('diary-btn-text').innerText = 'ডায়েরিতে সেভ করুন';
      document.getElementById('diary-cancel-btn').classList.add('hidden');
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-msg').innerText = msg;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3000);
    }

    function escapeHtml(str) {
      if (!str) return '';
      return str.replace(/[&<>"']/g, function(m) {
        return {
          '&': '&amp;',
          '<': '&lt;',
          '>': '&gt;',
          '"': '&quot;',
          "'": '&#039;'
        }[m];
      });
    }
  </script>
</body>
</html>
